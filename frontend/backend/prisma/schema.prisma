// Esquema do banco (PostgreSQL no Supabase). Aplicado pelas migrations em prisma/migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  concursos       Concurso[]
  disciplinas     Disciplina[]
  conteudos       Conteudo[]
  cronogramaItens CronogramaItem[]
  registrosEstudo RegistroEstudo[]

  @@map("usuarios")
}

model Concurso {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  titulo              String
  orgao               String    @default("")
  banca               String    @default("")
  cargo               String    @default("")
  nivel               String    @default("superior")
  vagas               Int       @default(0)
  salario             Decimal   @default(0) @db.Decimal(12, 2)
  dataProva           DateTime? @map("data_prova") @db.Date
  dataInscricaoInicio DateTime? @map("data_inscricao_inicio") @db.Date
  dataInscricaoFim    DateTime? @map("data_inscricao_fim") @db.Date
  urlEdital           String    @default("") @map("url_edital")
  observacoes         String    @default("")
  // meta de horas de estudo por semana; usada para dividir o tempo entre as disciplinas pelo peso
  metaHorasSemana     Decimal   @default(20) @map("meta_horas_semana") @db.Decimal(5, 1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario         Usuario          @relation(fields: [userId], references: [id], onDelete: Cascade)
  disciplinas     Disciplina[]
  conteudos       Conteudo[]
  cronogramaItens CronogramaItem[]
  registrosEstudo RegistroEstudo[]

  @@index([userId])
  @@map("concursos")
}

model Disciplina {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  concursoId String   @map("concurso_id") @db.Uuid
  nome       String
  cor        String   @default("#2563eb")
  peso       Decimal  @default(1) @db.Decimal(6, 1)
  ordem      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario         Usuario          @relation(fields: [userId], references: [id], onDelete: Cascade)
  concurso        Concurso         @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  conteudos       Conteudo[]
  cronogramaItens CronogramaItem[]
  registrosEstudo RegistroEstudo[]

  @@index([concursoId, ordem])
  @@index([userId])
  @@map("disciplinas")
}

// Árvore de conteúdos: parentId aponta para o item pai.
model Conteudo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  concursoId   String   @map("concurso_id") @db.Uuid
  disciplinaId String   @map("disciplina_id") @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  titulo       String
  observacao   String   @default("")
  status       String   @default("pendente")
  ordem        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario         Usuario          @relation(fields: [userId], references: [id], onDelete: Cascade)
  concurso        Concurso         @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  disciplina      Disciplina       @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  pai             Conteudo?        @relation("ConteudoArvore", fields: [parentId], references: [id], onDelete: Cascade)
  filhos          Conteudo[]       @relation("ConteudoArvore")
  cronogramaItens CronogramaItem[]
  registrosEstudo RegistroEstudo[]

  @@index([concursoId])
  @@index([disciplinaId, ordem])
  @@index([parentId])
  @@index([userId])
  @@map("conteudos")
}

// O que está planejado para estudar em cada dia.
model CronogramaItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  concursoId     String   @map("concurso_id") @db.Uuid
  disciplinaId   String?  @map("disciplina_id") @db.Uuid
  conteudoId     String?  @map("conteudo_id") @db.Uuid
  data           DateTime @db.Date
  horario        String   @default("19:00")
  duracaoMinutos Int      @default(60) @map("duracao_minutos")
  titulo         String   @default("Estudo")
  descricao      String   @default("")
  tipo           String   @default("teoria")
  concluido      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario         Usuario          @relation(fields: [userId], references: [id], onDelete: Cascade)
  concurso        Concurso         @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  disciplina      Disciplina?      @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  conteudo        Conteudo?        @relation(fields: [conteudoId], references: [id], onDelete: SetNull)
  registrosEstudo RegistroEstudo[]

  @@index([concursoId, data])
  @@index([userId])
  @@map("cronograma_itens")
}

// Sessões de estudo realizadas.
model RegistroEstudo {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  concursoId       String    @map("concurso_id") @db.Uuid
  disciplinaId     String?   @map("disciplina_id") @db.Uuid
  conteudoId       String?   @map("conteudo_id") @db.Uuid
  cronogramaItemId String?   @map("cronograma_item_id") @db.Uuid
  data             DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  minutos          Int
  // aula, questoes, revisao, leitura, resumo, simulado
  atividades       String[]  @default([])
  questoesFeitas   Int       @default(0) @map("questoes_feitas")
  questoesAcertos  Int       @default(0) @map("questoes_acertos")
  foco             Int?      @db.SmallInt
  anotacao         String    @default("")
  iniciadoEm       DateTime? @map("iniciado_em") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario        Usuario         @relation(fields: [userId], references: [id], onDelete: Cascade)
  concurso       Concurso        @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  disciplina     Disciplina?     @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  conteudo       Conteudo?       @relation(fields: [conteudoId], references: [id], onDelete: SetNull)
  cronogramaItem CronogramaItem? @relation(fields: [cronogramaItemId], references: [id], onDelete: SetNull)

  @@index([concursoId, data(sort: Desc)])
  @@index([disciplinaId])
  @@index([userId])
  @@map("registros_estudo")
}
