# ---------- Banco: PostgreSQL do Supabase ----------
# Supabase → botão "Connect" → "Session pooler" (funciona em IPv4, necessário no Render).
# Formato: postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Se a senha tiver caracteres especiais (@ : / # ?), codifique-os (ex.: @ vira %40).
DATABASE_URL=postgresql://postgres.quhhgnzvvmbedvivhsqc:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Usada só pelas migrations do Prisma. Pode ser igual à DATABASE_URL (modo sessão, porta 5432).
DIRECT_URL=postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# SSL do Postgres. "true" para o Supabase; "false" só para um Postgres local sem SSL.
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# ---------- Autenticação ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=30d
# Depois de criar sua conta, ponha false para ninguém mais se cadastrar.
ALLOW_REGISTRATION=true

# ---------- Servidor ----------
PORT=3000
# Endereços do frontend autorizados a chamar a API, separados por vírgula.
CORS_ORIGIN=http://localhost:5173
